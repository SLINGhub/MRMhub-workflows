# Quarto / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Rproj

# Quarto render cache (never commit)
*_files/
*_cache/
output/

# Transient render artifacts
*.rmarkdown
Rplots.pdf
figure/

# Per-notebook render outputs that leak into the repo root. The published site
# is docs/ (output-dir); these single-file HTML and generated LaTeX sources are
# regenerated by `quarto render`, so they are never tracked. caption-font.tex is
# a source include, so only the *generated* root-level .tex files are ignored.
/site_libs/
/Dataset*.html
/Dataset*.tex
/Dataset*.pdf
/ManuscriptFigure.html
/ManuscriptFigure.tex
/ManuscriptFigure.pdf
/index.html

# LaTeX / lualatex intermediates from PDF rendering
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Quarto default output folder (if you’re not using it)
_site/

# Quarto freeze cache (freeze: auto). Local render speed-up only; the published
# site is the committed docs/, so the freeze cache is not tracked.
/_freeze/

# OS files
.DS_Store
Thumbs.db

# Python venvs or renv caches if used
.venv/
renv/library/

/.quarto/
**/*.quarto_ipynb
.Rproj.user
.Rdata
.httr-oauth
.quarto

# Bulk data stays ignored, but keep each dataset's README.txt tracked so the
# folders are visible on GitHub with their Zenodo provenance.
data/dataset-*/*
!data/dataset-*/README.txt

# Superseded raw versions moved out of the dataset folders (kept locally, never committed)
_archive/

# Figure-regeneration inputs: by_transition PDFs are large and archived on Zenodo
# (see scripts/dataset4-chromatograms/by_transition/README.txt). Keep the README + script tracked.
scripts/dataset4-chromatograms/by_transition/*.pdf

# Zenodo distribution archives (built on demand, not tracked)
/dist/

# Local agent instructions
CLAUDE.md
